#!/bin/sh
# Finds a Node that has node:sqlite (22.5+), then runs the vareon command line.
here="$(cd "$(dirname "$0")" && pwd)"
ok(){ [ -x "$1" ] && "$1" -e 'process.exit(require("node:module").builtinModules.includes("node:sqlite")?0:1)' 2>/dev/null; }
for candidate in "$VAREON_NODE" "$here/../build-resources/node" "/Users/$USER/Desktop/VareonHQ.app/Contents/Resources/node" /usr/local/bin/node /opt/homebrew/bin/node "$(command -v node)"; do
  if [ -n "$candidate" ] && ok "$candidate"; then exec "$candidate" --no-warnings "$here/vareon.mjs" "$@"; fi
done
echo "vareon: needs Node 22.5 or newer (for node:sqlite). Set VAREON_NODE to a suitable node." >&2
exit 1
